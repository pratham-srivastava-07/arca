# ── Clerk Auth ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Option A - Local: postgresql://postgres:password@localhost:5432/sublytics
# Option B - Neon (free): https://neon.tech
DATABASE_URL="postgresql://user:password@localhost:5432/sublytics"

# ── Seed Script (optional) ────────────────────────────────────────────────────
# After signing up, grab your Clerk user ID from clerk.com/dashboard → Users
DEMO_CLERK_ID=user_xxxxxxxxxxxxxxxx
DEMO_EMAIL=prathamrajsri2003@gmail.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
# https://resend.com → API Keys. RESEND_FROM must be a verified domain in prod;
# onboarding@resend.dev works for testing to your own address only.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="Arca <onboarding@resend.dev>"

# ── Cron ─────────────────────────────────────────────────────────────────────
# Random string; Vercel sends it as a Bearer token to /api/cron/daily
CRON_SECRET=generate-a-long-random-string
